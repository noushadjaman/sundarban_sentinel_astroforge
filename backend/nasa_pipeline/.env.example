# NASA Earthdata Bearer Token (EDL Bearer Token)
# Obtain from https://urs.earthdata.nasa.gov -> Profile -> Generate Token
EARTHDATA_TOKEN=your_earthdata_bearer_token_here

# Firebase Configuration
FIREBASE_PROJECT_ID=sundarban-santinel
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_SERVICE_ACCOUNT_PATH=service.json

# Sundarbans Spatial Extent (West, South, East, North)
SUNDARBAN_BBOX=89.00,21.50,89.95,22.50
NDVI_ANOMALY_THRESHOLD=-0.15
